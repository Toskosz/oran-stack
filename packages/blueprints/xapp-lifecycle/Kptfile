apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: xapp-lifecycle
  annotations:
    config.kubernetes.io/local-config: "true"
info:
  description: >
    Functional gate and recovery for the simple-mon xApp: synchronize RTMgr,
    restart and resubscribe the xApp, preserve indication routes, and require
    an E2SM-KPM indication.
